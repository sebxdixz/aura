POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=3000
DASHBOARD_PORT=3001

# Path (inside API container) where e-commerce codebase is mounted for RAG.
ECOMMERCE_CODEBASE_PATH=/workspace/ecommerce_repo
RAG_REPO_NAME=ecommerce
RAG_AUTO_INDEX=true
RAG_TOP_K=4
RAG_EMBEDDING_DIM=1536
RAG_MAX_FILES=500
RAG_MAX_CHUNKS_PER_FILE=50
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_MAX_FILE_BYTES=200000
RAG_DEFAULT_TENANT_ID=default

# Admin credentials for tenant-scoped RAG ingestion endpoints.
# Option A (recommended): JSON map by tenant_id
TENANT_ADMIN_KEYS_JSON={"demo":"change-me"}
# Option B (fallback global key for all tenants)
TENANT_ADMIN_KEY=

# Optional token for private GitHub repos / higher API rate limits
GITHUB_TOKEN=

# ─── Integration mode ──────────────────────────────────────────
# Set MOCK_MODE=false to activate real Jira + Slack integrations.
# Set MOCK_MODE=true for stable hackathon demo without credentials.
MOCK_MODE=true
REACT_ENGINE=legacy
MULTIMODAL_PIPELINE=legacy

INTEGRATION_RETRIES=2
INTEGRATION_RETRY_DELAY_MS=150

# ReAct via OpenRouter + MCP (optional)
# Set REACT_ENGINE=openrouter_mcp to enable this path.
# Multimodal two-stage triage (optional):
# Set MULTIMODAL_PIPELINE=openrouter_two_stage to run:
#   1) OPENROUTER_MULTIMODAL_MODEL (e.g. gemini-2.5-flash) for extraction
#   2) OPENROUTER_ANALYSIS_MODEL for final SRE analysis JSON
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MULTIMODAL_MODEL=google/gemini-2.5-flash
OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o-mini

# MCP endpoint options:
# 1) Generic bridge (single endpoint dispatching by "server")
MCP_BRIDGE_URL=http://mcp_bridge:8080/invoke
MCP_BRIDGE_TOKEN=
MCP_BRIDGE_TIMEOUT_MS=35000

# 2) Optional direct endpoints per server (override bridge when set)
MCP_JIRA_URL=
MCP_SLACK_URL=

# Tool mapping for ReAct planner/executor
MCP_JIRA_SERVER=jira
MCP_JIRA_TOOL=jira_create_issue
MCP_SLACK_SERVER=slack
MCP_SLACK_TOOL=slack_post_message

# MCP runtime command overrides (advanced)
JIRA_MCP_COMMAND=mcp-atlassian
JIRA_MCP_ARGS=
SLACK_MCP_COMMAND=npx
SLACK_MCP_ARGS=-y @modelcontextprotocol/server-slack

# ─── Ticketing ─────────────────────────────────────────────────
# TICKETING_PROVIDER options: jira | mock-jira
# Set to "jira" and fill JIRA_* vars to create real issues.
TICKETING_PROVIDER=mock-jira
TICKETING_FALLBACK_PROVIDER=mock-linear

# ─── Team Communicator ─────────────────────────────────────────
# COMMUNICATOR_PROVIDER options: slack | mock-slack
# Set to "slack" and fill SLACK_WEBHOOK_URL to post real messages.
COMMUNICATOR_PROVIDER=mock-slack
COMMUNICATOR_FALLBACK_PROVIDER=mock-teams

# ─── Email (reporter notification) ────────────────────────────
EMAIL_PROVIDER=mock-email
EMAIL_FALLBACK_PROVIDER=mock-ses

# ─── Fault-injection flags (for demo/testing only) ────────────
FORCE_FAIL_PRIMARY_TICKETING=false
FORCE_FAIL_FALLBACK_TICKETING=false
FORCE_FAIL_PRIMARY_COMMUNICATOR=false
FORCE_FAIL_FALLBACK_COMMUNICATOR=false
FORCE_FAIL_PRIMARY_EMAIL=false
FORCE_FAIL_FALLBACK_EMAIL=false

# ─── Jira Cloud ────────────────────────────────────────────────
# Required when TICKETING_PROVIDER=jira and MOCK_MODE=false
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=sre@your-org.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=AURA
JIRA_DEFAULT_ISSUE_TYPE=Bug

# Required when using MCP Atlassian server (jira_create_issue)
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=sre@your-org.com
# Alternative for Server/Data Center:
JIRA_PERSONAL_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# ─── Slack Incoming Webhook ────────────────────────────────────
# Required when COMMUNICATOR_PROVIDER=slack and MOCK_MODE=false
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXX/BXXXXXXX/xxxxxxxxxxxxxxxxxxxxxxxx

# Required when using MCP Slack server (slack_post_message)
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_DEFAULT_CHANNEL_ID=

# ─── OpenAI (future LLM triage) ───────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TRIAGE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── SMTP (future real email) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
