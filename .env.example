# ==========================================
# AURA environment template
# Copy to .env before running docker compose
# Default values are mock/demo friendly.
# ==========================================

# ------------------------------------------
# App / ports
# ------------------------------------------
API_PORT=8000
WEB_PORT=3000
DASHBOARD_PORT=3001
# Direct intake-only surface (`web_report` service).
UNIFIED_WEB_PORT=3002

# Mounted paths inside the API and worker containers.
ECOMMERCE_CODEBASE_PATH=/workspace/ecommerce_repo
ATTACHMENTS_DIR=/workspace/attachments

# ------------------------------------------
# Database
# ------------------------------------------
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura
POSTGRES_PORT=5432

# DATABASE_URL is injected by docker-compose from the values above.
# Override only if you run the API/worker outside compose.
# DATABASE_URL=postgresql://aura:aura@db:5432/aura

# ------------------------------------------
# Tenant auth / admin access
# ------------------------------------------
# Recommended: per-tenant admin keys as JSON.
TENANT_ADMIN_KEYS_JSON={"demo":"change-me"}

# Optional fallback global admin key for every tenant.
TENANT_ADMIN_KEY=

# Required for encrypting tenant-scoped Jira/Slack secrets saved from the dashboard.
# Replace before sharing outside local demo environments.
SECRETS_ENCRYPTION_KEY=change-this-in-production

# Optional GitHub token for private repos or higher API rate limits during RAG sync.
GITHUB_TOKEN=

# ------------------------------------------
# Runtime mode
# ------------------------------------------
# MOCK_MODE=true keeps the whole stack runnable without external credentials.
# Set MOCK_MODE=false only when you want real integrations.
MOCK_MODE=true

# ReAct orchestration path:
# - legacy: direct/provider-first execution
# - openrouter_mcp: OpenRouter planner + MCP tool execution
REACT_ENGINE=legacy

# Multimodal triage path:
# - legacy: deterministic + optional model enrichment
# - openrouter_two_stage: multimodal extraction + analysis model
MULTIMODAL_PIPELINE=legacy

# ------------------------------------------
# RAG / repository context
# ------------------------------------------
RAG_REPO_NAME=ecommerce
RAG_DEFAULT_TENANT_ID=default
RAG_AUTO_INDEX=true
RAG_TOP_K=4
RAG_EMBEDDING_DIM=1536
RAG_MAX_FILES=500
RAG_MAX_CHUNKS_PER_FILE=50
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_MAX_FILE_BYTES=200000

# ------------------------------------------
# LLM / multimodal
# ------------------------------------------
# OpenAI is optional. In mock mode these can be left empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TRIAGE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter is optional. Used for live model paths and ReAct planner mode.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MULTIMODAL_MODEL=google/gemini-2.5-flash
OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o-mini

# ------------------------------------------
# ReAct / MCP bridge (optional advanced mode)
# ------------------------------------------
MCP_BRIDGE_URL=http://mcp_bridge:8080/invoke
MCP_BRIDGE_TOKEN=
MCP_BRIDGE_TIMEOUT_MS=35000

# Optional direct MCP endpoints. Leave empty to use the bridge.
MCP_JIRA_URL=
MCP_SLACK_URL=

# Tool mapping for planner/executor.
MCP_JIRA_SERVER=jira
MCP_JIRA_TOOL=jira_create_issue
MCP_SLACK_SERVER=slack
MCP_SLACK_TOOL=slack_post_message

# Runtime command overrides used by the bridge container.
JIRA_MCP_COMMAND=mcp-atlassian
JIRA_MCP_ARGS=
SLACK_MCP_COMMAND=npx
SLACK_MCP_ARGS=-y @modelcontextprotocol/server-slack

# ------------------------------------------
# Ticketing
# ------------------------------------------
# Options: mock-jira | jira
TICKETING_PROVIDER=mock-jira
TICKETING_FALLBACK_PROVIDER=mock-linear

# Real Jira mode. Required only when TICKETING_PROVIDER=jira and MOCK_MODE=false.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=sre@your-org.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=AURA
JIRA_DEFAULT_ISSUE_TYPE=Bug

# Optional MCP Atlassian credentials.
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=sre@your-org.com
JIRA_PERSONAL_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# ------------------------------------------
# Team communicator
# ------------------------------------------
# Options: mock-slack | slack
COMMUNICATOR_PROVIDER=mock-slack
COMMUNICATOR_FALLBACK_PROVIDER=mock-teams

# Real Slack mode. Required only when COMMUNICATOR_PROVIDER=slack and MOCK_MODE=false.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXX/BXXXXXXX/xxxxxxxxxxxxxxxxxxxxxxxx

# Optional MCP Slack credentials.
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_DEFAULT_CHANNEL_ID=

# ------------------------------------------
# Reporter email
# ------------------------------------------
# Options: mock-email | resend
EMAIL_PROVIDER=mock-email
EMAIL_FALLBACK_PROVIDER=mock-email
EMAIL_FROM=alerts@example.com
EMAIL_FROM_NAME=AURA
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=10

# Required only when EMAIL_PROVIDER=resend.
EMAIL_RESEND_API_KEY=
EMAIL_RESEND_BASE_URL=https://api.resend.com/emails

# ------------------------------------------
# Worker / jobs / retries
# ------------------------------------------
INTEGRATION_RETRIES=2
INTEGRATION_RETRY_DELAY_MS=150
WORKER_NAME=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_TICKET_SYNC_INTERVAL_SECONDS=60
WORKER_RETRY_DELAY_SECONDS=5

# Mock ticket auto-resolution is useful for demos.
MOCK_TICKET_AUTO_RESOLVE=false
MOCK_TICKET_AUTO_RESOLVE_AFTER_SECONDS=45

# ------------------------------------------
# Observability
# ------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_MODE=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_ENVIRONMENT=local
OTEL_SERVICE_VERSION=0.5.0

# Note: OTEL_SERVICE_NAME is injected by docker-compose per service.
# API uses aura-api and worker uses aura-worker by default.
# OTEL_SERVICE_NAME=aura-api

# ------------------------------------------
# Demo / failure injection (optional)
# ------------------------------------------
FORCE_FAIL_PRIMARY_TICKETING=false
FORCE_FAIL_FALLBACK_TICKETING=false
FORCE_FAIL_PRIMARY_COMMUNICATOR=false
FORCE_FAIL_FALLBACK_COMMUNICATOR=false
FORCE_FAIL_PRIMARY_EMAIL=false
FORCE_FAIL_FALLBACK_EMAIL=false
